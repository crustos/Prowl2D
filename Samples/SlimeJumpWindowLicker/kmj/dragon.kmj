'''
Ember, the dragon who carries Gelly off.  A big head with horns, two yellow eyes with slits, nostrils that smoke.
roar() opens the jaw and lets a flame out.
'''

def eye(fill={0:gold, 10:black}, smooth=1.0):
    0         1


        10


    3         2

def dragon(fill={0:crimson, 10:wheat, 14:wheat, 20:white, 30:white, 40:darkred, 42:darkred}, stroke={0:darkred, 10:sienna, 14:sienna, 60:black}, width={0:0.35, 10:0.35, 14:0.35, 60:0.5}, smooth=0.75, sizes={20:(8, 6), 30:(8, 6), 40:(2, 2), 42:(2, 2)}):
        10                        14


      11              0               15

           7  12              16 1



              20            30
     6                                 2


                  40    42

                60         62~
         5                         3
                      61
                      4

def pose(look=(0, 0), blink=0, lift=0):
    s = 1 - blink
    left = eye(shift={10: look}, scale={0: (1, max(0.15, s)), 10: (0.4, s)})
    right = eye(shift={10: look}, scale={0: (1, max(0.15, s)), 10: (0.4, s)})
    return dragon({20: left, 30: right}, shift={0: (0, -lift)})

glare = [pose(look=(x, 0)) for x in [0, -1, 0, 1]]
rest  = pose()
