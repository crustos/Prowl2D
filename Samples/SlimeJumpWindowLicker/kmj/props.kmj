## ---------------------------------------------------------------- the stretch limo (the party arrives in it)
def wheel(fill={0:black, 10:lightgray}, sizes={10:2.4}, smooth=1.0):
    0     1
        10
    3     2

def limo(fill={0:deeppink, 11:skyblue, 21:skyblue, 31:skyblue, 41:lightcyan, 80:gold, 90:none, 91:none}, stroke={0:maroon, 11:navy, 21:navy, 31:navy, 41:navy, 80:darkorange, 90:none, 91:none}, width={0:0.45, 11:0.3, 21:0.3, 31:0.3, 41:0.3}, smooth={0:0.7, 11:0.3, 21:0.3, 31:0.3, 41:0.3}, sizes={50:(8, 8), 60:(8, 8), 70:(8, 8), 80:(3, 3), 90:(0.1, 0.1), 91:(0.1, 0.1)}):
    90

                                      1
       0                                                          2

          11      12  21      22  31      32  41        42

     7                                                                    3
          14      13  24      23  34      33  44            43          80


          6                                                       4
                  50          5             70            60

                                                                              91

def ride(b=0):
    return limo(shift={i: (0, -b) for i in [0, 11, 21, 31, 41, 80]})

drive = [ride(b) for b in [0, 0.5, 1, 0.5]]
limo_rest = ride()

## ---------------------------------------------------------------- the disco ball: sparkles that crawl around it
def ball(fill={0:silver, 10:white, 20:white, 30:white, 40:white, 90:none, 91:none}, stroke={0:gray, 95:dimgray, 90:none, 91:none}, width={0:0.4, 95:0.25}, smooth={0:0.85}, sizes={10:(2, 2), 20:(1.6, 1.6), 30:(1.2, 1.2), 40:(1.8, 1.8), 90:(0.1, 0.1), 91:(0.1, 0.1)}):
    90          95

                96
                0
         7             1
                  40
             10

      6                   2
                   20
               30

         5             3
                4
                            91

def glint(k=0):
    return ball(shift={10: (k * 1.4 - 2, 0), 20: (-k * 1.2, 0.5 * k), 30: (k * 0.9, -0.5 * k), 40: (-k * 1.0 + 1, 0.4 * k)})

spin = [glint(k) for k in [0, 1, 2, 3, 2, 1]]
ball_rest = glint()

## ---------------------------------------------------------------- a speaker stack for the club
def speaker(fill={1:dimgray, 90:none, 91:none}, stroke={1:black, 90:none, 91:none}, width={1:0.5}, smooth={1:0.2}, sizes={50:(10, 10), 60:(6, 6), 90:(0.1, 0.1), 91:(0.1, 0.1)}):
    901                   2



              50






               60



      4                   3
                            91

speaker_rest = speaker()
