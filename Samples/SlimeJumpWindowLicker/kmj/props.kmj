'''
Props for SlimeJumpRPG: heart gems, memory flowers (checkpoints), thorns, vines, the wedding arch (the goal), the dragon's keep
and some scenery.  The two invisible dots 90 and 91 are a frame: they fix the canvas, so a tile has the same size in every frame.
'''

## ---------------------------------------------------------------- gem: a heart that beats
def heart(fill={0:crimson, 10:white}, stroke=darkred, smooth=0.55, sizes={10:(2, 2)}):
      5     1
         0
    4   10    2



         3

def beat(k=1):
    return heart(scale={0: k})

gem = [beat(k) for k in [1, 1.12, 1.25, 1.1]]
gem_rest = beat(1)

## ---------------------------------------------------------------- checkpoint: a memory flower
def flower(fill={0:gold, 10:pink, 20:pink, 30:pink, 40:pink, 50:pink, 70:green, 72:green, 90:none, 91:none}, stroke={10:hotpink, 20:hotpink, 30:hotpink, 40:hotpink, 50:hotpink, 60:darkgreen, 90:none, 91:none}, width={60:0.7}, sizes={0:(3, 3), 10:(4, 4), 20:(4, 4), 30:(4, 4), 40:(4, 4), 50:(4, 4), 70:(4, 2), 72:(4, 2), 90:(0.1, 0.1), 91:(0.1, 0.1)}):
    90    10
      50    20
          0
        40  30
          60
      70    72
          61    91

bloom = [flower(scale={0: k, 10: k, 20: k, 30: k, 40: k, 50: k}) for k in [1, 1.1, 1.2, 1.1]]
flower_rest = flower()

## ---------------------------------------------------------------- hazard: thorns
def thorns(fill={1:darkolivegreen, 11:darkolivegreen, 21:darkolivegreen, 90:none, 91:none}, stroke={1:black, 11:black, 21:black, 90:none, 91:none}, sizes={90:(0.1, 0.1), 91:(0.1, 0.1)}):
    90      12
      2               22






    1   3 11    13  21  23  91

thorns_rest = thorns()

## ---------------------------------------------------------------- vine: climb it
def vine(fill={10:limegreen, 20:limegreen, 90:none, 91:none}, stroke={0:darkgreen, 10:darkgreen, 20:darkgreen, 90:none, 91:none}, width={0:0.8}, smooth=0.9, sizes={10:(3, 2), 20:(3, 2), 90:(0.1, 0.1), 91:(0.1, 0.1)}):
    90  0
    20     1
          10
     2
        3~  91

vine_rest = vine()

## ---------------------------------------------------------------- the goal: the wedding arch
def arch(fill={1:white, 6:white, 30:pink, 40:pink, 50:white, 60:crimson, 90:none, 91:none}, stroke={1:lightgray, 6:lightgray, 20:hotpink, 30:hotpink, 40:hotpink, 50:gold, 90:none, 91:none}, width={20:1.1, 1:0.3, 6:0.3}, smooth={20:0.9}, sizes={30:(3, 3), 40:(3, 3), 50:(3, 3), 60:(5, 4), 90:(0.1, 0.1), 91:(0.1, 0.1)}):
    90      21
        30        40

    2 3     50       7 8
    20               22~

            60



    1 4              6 9  91

def glow(k=1):
    return arch({60: heart(scale={0: k})}, scale={30: k, 40: k, 50: k})

wedding = [glow(k) for k in [1, 1.15, 1.3, 1.15]]
arch_rest = arch({60: heart()})

## ---------------------------------------------------------------- scenery
def tree(fill={1:saddlebrown, 10:seagreen, 90:none, 91:none}, stroke={1:maroon, 10:darkgreen, 90:none, 91:none}, smooth={10:0.85}, sizes={90:(0.1, 0.1), 91:(0.1, 0.1)}):
    90        10

        16            11


              2  3
      15                12

            14    13


             1    4       91

def sway(k=0):
    return tree(rotate={10: k}, shift={10: (k * 0.1, 0)})

tree_sway = [sway(k) for k in [0, 1, 0, -1]]
tree_rest = tree()

def bush(fill={0:green, 10:red, 20:red, 90:none, 91:none}, stroke={0:darkgreen, 10:maroon, 20:maroon, 90:none, 91:none}, smooth={0:0.9}, sizes={10:(2, 2), 20:(2, 2), 90:(0.1, 0.1), 91:(0.1, 0.1)}):
    90   0
              1
            20
    5   10
                 2

       4      3 91

bush_rest = bush()

def cloud(fill={0:white, 90:none, 91:none}, stroke={0:lavender, 90:none, 91:none}, smooth={0:0.95}, sizes={90:(0.1, 0.1), 91:(0.1, 0.1)}):
    90      1
         0      2
                   3
     6
        5        4  91

cloud_rest = cloud()

def hill(fill={0:yellowgreen, 90:none, 91:none}, stroke={0:olivedrab, 90:none, 91:none}, smooth={0:0.95}, sizes={90:(0.1, 0.1), 91:(0.1, 0.1)}):
    90               0


           4                   1




     3                               2  91

hill_rest = hill()

## ---------------------------------------------------------------- the dragon's keep
def castle(fill={1:slategray, 11:gray, 21:gray, 31:crimson, 41:crimson, 51:saddlebrown, 60:gold, 70:gold, 80:gold, 90:none, 91:none}, stroke={1:black, 11:black, 21:black, 31:maroon, 41:maroon, 51:black, 90:none, 91:none}, sizes={60:(2, 4), 70:(2, 4), 80:(2, 4), 90:(0.1, 0.1), 91:(0.1, 0.1)}):
    90  32                  42

    31    33              41    43
    12    13      80      22    23

        2                    3

                  53
      60                    70
              52    54




    11  1 14  51    55    21 4  24  91

