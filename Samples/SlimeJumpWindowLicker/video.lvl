STAGES = [(320.3, 337), (337, 349), (349, 361), (361, 373), (373, 385), (385, 410)]
for mi, (a, b) in enumerate(STAGES):
    dance("gm", a, b, [f"m{mi}_{k}" for k in range(6)], every=1, hop=0.7)
    dance("gmy", a, b, [f"m{mi}_{(k + 3) % 6}" for k in range(6)], every=1, hop=0.7)
def stage_at(t):
    for mi, (a, b) in enumerate(STAGES):
        if t < b:
            return mi
    return 5
## champagne: pop, spray
