## SlimeJump Window Licker: a love story.  (a parody music video; the track is yours: this file only reads numbers from audio.json)
##
## Stage (cells, 21 rows, the ground is row 17):
##     x   0 ..  63  the street          x 192 .. 511  ten close-up rooms, 32 cells each (one per face)
##     x  64 .. 127  the limo lounge
##     x 128 .. 191  the beach
## The artwork: svg/*.svg are drawn by gen_svg.py (python), kmj/*.kmj are kaomojilang (the little ones: Gelly, Jelly and the frogs).
## The timing: audio.json (analyze_audio.py): the loudness drives the mouths, the hits of the music are where the shots change.
##
##     python3 Samples/SlimeJumpWindowLicker/gen_svg.py
##     python3 Samples/SlimeJumpWindowLicker/analyze_audio.py TRACK.mp3 Samples/SlimeJumpWindowLicker/audio.json
##     python3 tools/levelang scene Samples/SlimeJumpWindowLicker/video.lvl --fps 8 --tile 20 --mp4 out.mp4 --audio TRACK.mp3

meta(width=608, height=21)
background("#7fd0ff", "#ffe8c0")

J = data("audio.json")
EN = J["energy"]
ONS = J["onsets"]
DUR = J["duration"]
FPS = 8
G = 17

## ---------------------------------------------------------------- tiles from python (no emoji needed: tiles are made in code)
def mk(name, *attrs):
    return __tile__(name, "", list(attrs))

def sv(name, file, w, h, *more):
    return mk(name, svg("svg/" + file), size(w, h), *more)

def sq(name, pattern, w, h, fps=6):
    return mk(name, svgs("svg/" + pattern, fps=fps), size(w, h))

def km(name, file, shape, w, h, fps=6):
    return mk(name, kmj("kmj/" + file, shape, fps=fps, margin=0), size(w, h))

NIL = mk("nil", svg('<svg viewBox="0 0 1 1"></svg>'))

## the kaomojilang people: one dict of poses each (the same names: idle talk0 talk1 talk2 no/lean heart cry smug)
GW, GH = 5.4, 4.7
def people(prefix, file, idle, talk, extra, w, h):
    d = {"idle": km(prefix + "idle", file, idle, w, h, 4)}
    for i in range(3):
        d[f"talk{i}"] = km(f"{prefix}talk{i}", file, talk + str(i), w, h)
    for key, shape in extra.items():
        d[key] = km(prefix + key, file, shape, w, h, 5)
    return d

GELLY = people("gl_", "gelly.kmj", "idle", "talk", {"no": "no", "heart": "heart"}, GW, GH)
JELLY = people("jl_", "gelly.kmj", "y_idle", "y_talk", {"no": "y_no", "heart": "y_heart"}, GW, GH)
CROAK = people("cr_", "frog.kmj", "croak", "talk", {"lean": "lean", "cry": "cry", "smug": "smug"}, 4.2, 3.4)
RIBBIT = people("rb_", "frog.kmj", "b_idle", "b_talk", {"lean": "b_lean", "cry": "b_cry", "smug": "b_smug"}, 4.2, 3.4)
CROAK["face"] = sq("cr_face", "popfrog_*.svg", 4.2, 3.7, 5)       ## "everyone gets the face": the face pops onto the frogs, the car, the girls
RIBBIT["face"] = sq("rb_face", "popfrog_*.svg", 4.2, 3.7, 5)
GELLY["face"] = sq("gl_face", "morph_5_*.svg", GH * 0.76, GH, 4)
JELLY["face"] = sq("jl_face", "morphy_5_*.svg", GH * 0.76, GH, 4)

HW, HH = 8, 9.2
HERO = {"idle": sq("h_strut", "hero_strut_*.svg", HW, HH, 4), "dance": sq("h_dance", "hero_dance_*.svg", HW, HH, 4.1), "slow": sq("h_slow", "hero_dance_*.svg", HW, HH, 1.6),
        "tada": sv("h_tada", "hero_pose_01.svg", HW, HH), "pose": sv("h_pose", "hero_pose_00.svg", HW, HH),
        "usher": sv("h_usher", "hero_pose_02.svg", HW, HH), "bow": sv("h_bow", "hero_pose_03.svg", HW, HH), "split": sv("h_split", "hero_pose_04.svg", HW, HH),
        "twirl": sq("h_twirl", "hero_twirl_*.svg", HW, HH, 7)}
HFACE = {"grin": sq("hf_grin", "hero_face_0[0-3].svg", 22, 16, 5), "crazy": sq("hf_crazy", "hero_face_nosh_*.svg", 22, 16, 5), "lick": sq("hf_lick", "hero_lick_*.svg", 22, 16, 2), "zoom": sq("hf_zoom", "hero_zoom_*.svg", 22, 16, 9),
         "ok": sv("hf_ok", "hero_face_00.svg", 22, 16)}
## the full-bleed close-ups (they fill the whole frame, so they have a room of their own): the extreme crops, the fisheye, the lights, the fog, the eye-roll
FB = {"fish": sq("hf_fish", "hero_fish_*.svg", 22, 16, 10), "red": sq("hf_red", "hero_lit_red_*.svg", 22, 16, 12), "blue": sq("hf_blue", "hero_lit_blue_*.svg", 22, 16, 12),
      "fog": sq("hf_fog", "hero_fog_*.svg", 22, 16, 1.6), "roll": sq("hf_roll", "hero_roll_*.svg", 22, 16, 14)}
for i in range(4):                                       ## one tile per size, so a zoom is four frames
    FB[f"g{i}"] = sv(f"hf_g{i}", f"grin_cu_{i:02d}.svg", 22, 16)
    FB[f"s{i}"] = sq(f"hf_s{i}", f"shades_cu_{i:02d}_*.svg", 22, 16, 9)
HHEAD = {"grin": sq("hh_grin", "hero_face_0[0-3].svg", 5.5, 4, 5)}

DANCERS = {c: sq("dn_" + c, f"dancer_{c}_*.svg", 7, 9.2, 4.1) for c in "abcd"}
GM = {f"m{i}_{k}": sv(f"gm{i}{k}", f"morph_{i}_{k}.svg", 7, 9.2) for i in range(6) for k in range(6)}
GMY = {f"m{i}_{k}": sv(f"gy{i}{k}", f"morphy_{i}_{k}.svg", 7, 9.2) for i in range(6) for k in range(6)}
DFACE_P = {f"m{i}": sv(f"dp{i}", f"dface_{i:02d}.svg", 22, 16) for i in range(5)}
DFACE_Y = {f"m{i}": sv(f"dy{i}", f"dface_y_{i:02d}.svg", 22, 16) for i in range(5)}
CHAMP = {f"c{i}": sv(f"ch{i}", f"champagne_{i:02d}.svg", 4, 6) for i in range(8)}
CHAMP_BIG = {f"c{i}": sv(f"chb{i}", f"champagne_{i:02d}.svg", 11, 16.5) for i in range(8)}
BOOM = sq("boom", "boombox_*.svg", 6, 3.6, 4.1)
BOOM_BIG = sq("boomb", "boombox_*.svg", 24, 14.4, 4.1)
GRANNY = sq("granny", "granny_*.svg", 7, 9.2, 4.1)
KID = sq("kid", "kid_*.svg", 5.6, 7.4, 4.1)
SUN = sq("sun", "sun_*.svg", 9, 9, 3)
BALL = sq("ball", "ball_*.svg", 3.4, 3.4, 8)
CORK = sq("cork", "cork_*.svg", 2, 2, 10)
SPRAY = sq("spray", "spray_*.svg", 32, 18, 5)
PALM = sq("palm", "palm_sway_*.svg", 6, 12, 3)

## ---------------------------------------------------------------- the sets
place(NIL, 0, 0)
place(NIL, 607, 0)
place(NIL, 0, 20)
place(NIL, 607, 20)
place(sv("street", "street_bg.svg", 64, 21, bg), 0, 0)
place(sv("lounge", "interior_bg.svg", 64, 21, bg), 64, 0)
place(sv("beach", "beach_bg.svg", 64, 21, bg), 128, 0)
ROOMS = ["hero", "pink", "blue", "lime", "lilac", "teal", "orange", "red", "purple", "sun", "static", "foam", "face"]
for i, r in enumerate(ROOMS):
    if r == "static":
        place(mk("room_static", svgs("svg/static_*.svg", fps=14), size(32, 18), bg), 192 + 32 * i, 1.5)
    else:
        place(sv("room_" + ("red" if r == "foam" else "sun" if r == "face" else r), f"room_{'red' if r == 'foam' else 'sun' if r == 'face' else r}.svg", 32, 18, bg), 192 + 32 * i, 1.5)
RC = {r: 208 + 32 * i for i, r in enumerate(ROOMS)}      ## the centre of each room
ARCH = sv("arch", "arch.svg", 10, 10)
BRIDE = sv("bride", "bride.svg", 7, 9.2)

## ---------------------------------------------------------------- the scene
scene("slimejump-window-licker", seconds=DUR, fps=FPS, view=(32, 18), bpm=J["tempo"])

## layers, back to front: the car's seat, the frogs, the car's body; the limo's inside, a head at the window, the glass, the limo's body
actor("car_back", sq("cbk", "car_back_*.svg", 14, 5.6, 3), -16, 13.8)
actor("croak", CROAK, -9.5, 13.4)
actor("ribbit", RIBBIT, -14, 13.4)
actor("car_front", {"idle": sq("cfr", "car_front_*.svg", 14, 5.6, 3), "face": sq("cfrf", "popcar_*.svg", 14, 5.6, 5)}, -16, 13.8)
actor("gelly", GELLY, 20.5, G - GH)
actor("jelly", JELLY, 26.4, G - GH)
actor("limo_back", sv("lmb", "limo_back.svg", 46, 6.2), 52, 13.0, flip=True)
actor("limo_head", HHEAD, 52 + 14.2 - 2.75, 13.0 + 1.0, size=(5.5, 4))
hide("limo_head", 0)
actor("limo_glass", sv("lmg", "limo_glass.svg", 46, 6.2), 52, 13.0, flip=True)
actor("limo_front", sv("lmf", "limo_front.svg", 46, 6.2), 52, 13.0, flip=True)
actor("limo_m1", sv("lm1", "limo_mid.svg", 46, 6.2), 52 + 46, 13.0)
actor("limo_m2", sv("lm2", "limo_mid.svg", 46, 6.2), 52 + 92, 13.0)
actor("limo_tail", sv("lmt", "limo_tail.svg", 46, 6.2), 52 + 138, 13.0)
actor("hero", HERO, 40, G - HH)
hide("hero", 0)

## the second and third set
actor("gm", GM, 82, G - 9.2 + 0.3)
actor("gmy", GMY, 101, G - 9.2 + 0.3)
hide("gm", 0)
hide("gmy", 0)
actor("champ", CHAMP, 98, 7)
hide("champ", 0)
BEACH_X = [139, 145, 151, 169, 175, 181, 134, 186]
BEACH_C = ["a", "b", "c", "d", "b", "a", "d", "c"]
for i, (x, c) in enumerate(zip(BEACH_X, BEACH_C)):
    actor(f"d{i}", DANCERS[c], x, G - 9.2 + (0.3 if i < 6 else -0.6))
    hide(f"d{i}", 0)
ROWX = [131, 142, 153, 164, 175, 186]
for i in range(6):
    actor(f"row{i}", DANCERS["abcd"[i % 4]], ROWX[i], G - 7.0, size=(5.2, 6.9))
    hide(f"row{i}", 0)
actor("granny", GRANNY, 165, G - 9.2)
actor("granny2", GRANNY, 143, G - 9.2, flip=True)
actor("kid", KID, 172, G - 6)
actor("kid2", KID, 150, G - 6)
actor("sun", SUN, 155, 1.0)
actor("ball", BALL, 134, G - 4.0)
actor("palm1", PALM, 129, G - 12.2)
actor("palm2", PALM, 189, G - 12.2)
actor("cork", CORK, 150, 4.0)
for nm in ("granny", "granny2", "kid", "kid2", "sun", "ball", "palm1", "palm2"):
    hide(nm, 0)
actor("boom", BOOM, 176, G - 3.6)
hide("boom", 0)
actor("arch", ARCH, 155, 7)
hide("arch", 0)
actor("bride", BRIDE, 163, G - 9.2)
hide("bride", 0)

## the close-ups: a face, big, in its own room
def cu(name, tiles, room, w, h):
    actor(name, tiles, RC[room] - w / 2, 10.5 - h / 2, size=(w, h))

cu("hero_cu", HFACE, "hero", 22, 16)
cu("gelly_cu", GELLY, "pink", 19, 16.5)
cu("jelly_cu", JELLY, "blue", 19, 16.5)
cu("croak_cu", CROAK, "lime", 20, 16.2)
cu("ribbit_cu", RIBBIT, "lilac", 20, 16.2)
cu("dface_p", DFACE_P, "teal", 22, 16)
cu("dface_y", DFACE_Y, "orange", 22, 16)
cu("champ_cu", CHAMP_BIG, "red", 11, 16.5)
cu("boom_cu", BOOM_BIG, "purple", 24, 14.4)
cu("hero_cu2", HFACE, "sun", 22, 16)
cu("hero_fb", FB, "face", 32, 23.27)
actor("foam_cu", SPRAY, RC["foam"] - 16, 1.5, size=(32, 18))

## ---------------------------------------------------------------- helpers
def wide(t, x, y=14.0, zoom=1.1):
    cut(t, x, y, zoom)

def room(t, name):
    cut(t, RC[name], 10.5, 1.0)

def flash(t, color="white", a=0.55, secs=0.2):
    fade(t, t + secs, a, 0, color)

ES = sorted(EN[:230 * FPS])
LO, HI = ES[int(len(ES) * 0.35)], ES[int(len(ES) * 0.70)]
def mouth(t):                                  ## how open the mouth is (0, 1, 2) when something loud is said at time t
    e = EN[min(len(EN) - 1, int(t * FPS))]
    return 0 if e < LO else 1 if e < HI else 2

def talk(names, t0, t1):                       ## flap these actors' mouths with the loudness of the track
    n = int(t0 * FPS)
    while n < int(t1 * FPS):
        for nm in names:
            pose(nm, n / FPS, f"talk{mouth(n / FPS)}")
        n += 1

def onsets(t0, t1, thresh=0.4, gap=0.8):       ## the hits of the music in [t0, t1): strong ones, at least `gap` seconds apart
    out, last = [], -9
    for t, s in ONS:
        if t0 <= t < t1 and s >= thresh and t - last >= gap:
            out.append((t, s))
            last = t
    return out

def punches(t0, t1, thresh=0.5, gap=0.3, amt=0.06):
    last = -9
    for t, s in ONS:
        if t0 <= t < t1 and s >= thresh and t - last >= gap:
            punch(t, amt * (0.6 + 0.8 * s), 0.25)
            last = t

def edit(t0, t1, shots, thresh=0.4, gap=0.8, flashes=0.8):    ## cut on the hits: each hit starts the next shot of the list
    pts = onsets(t0, t1, thresh, gap)
    for i, (t, s) in enumerate(pts):
        shots[i % len(shots)](t)
        if s >= flashes:
            flash(t, ["white", "#ff3cac", "#ffe45a", "#3cdcff"][i % 4], 0.45, 0.2)
    return pts

## ================================================================ ACT 1  0:00 - 3:50   the street corner: a very long conversation (now with gags, lurches, hops and a cut every second)
def glyph(ch, col):
    return mk("g" + str(abs(hash(ch + col)) % 9999), svg(f'<svg viewBox="0 0 10 10"><text x="5" y="8.6" font-size="10" text-anchor="middle" font-weight="bold" fill="{col}" stroke="#2a1a3a" stroke-width="0.6" font-family="sans-serif">{ch}</text></svg>'), size(2, 2))
EXCL, QUEST, ANGRY, NOTE, SWEAT = glyph("!", "#ffe45a"), glyph("?", "#7fe0ff"), glyph("#", "#ff4f6e"), glyph("♪", "#9cff7a"), glyph("..", "#bfe8ff")

card(0.6, "SLIMEJUMP", "WINDOW LICKER", seconds=3.2)
fade(0, 1.2, 1, 0)
LINES = [
    ("croak", "Hey, ladies."), ("gelly", "No."), ("ribbit", "Hey, ladies!"), ("jelly", "Also no."),
    ("croak", "We have a car."), ("gelly", "It is a very small car."), ("croak", "It is a very nice small car."), ("jelly", "It has no roof."),
    ("ribbit", "It has a roof. It is just not on."), ("gelly", "Keep driving."), ("croak", "We ARE driving."), ("jelly", "You are parked."),
    ("croak", "We are parked while driving."), ("ribbit", "For the ambience."), ("gelly", "What ambience?"), ("croak", "Ribbit. Do the ambience."),
    ("ribbit", "Ribbit."), ("jelly", "That is not ambience. That is a frog."),
    ("narr", "Four minutes later."),
    ("croak", "Hey, ladies."), ("gelly", "We already did this one."), ("ribbit", "Do it again."), ("croak", "Hey, ladies."), ("jelly", "No."),
    ("gelly", "Still no."), ("croak", "We have snacks."), ("ribbit", "Flies. Mostly flies."), ("jelly", "Disgusting."),
    ("croak", "Gourmet."), ("ribbit", "Artisan."), ("croak", "Locally sourced."), ("gelly", "From where?"),
    ("ribbit", "The windshield."), ("jelly", "Oh my gosh."),
    ("narr", "Nine minutes later."),
    ("gelly", "I have a boyfriend."), ("croak", "Where is he?"), ("gelly", "He is... on his way."), ("ribbit", "Everyone is on their way."),
    ("jelly", "He is a slime. He is lovely."), ("croak", "Slimes are just frogs with no plan."), ("gelly", "Excuse me?"), ("ribbit", "He has a point. A small one."),
    ("croak", "Hey, ladies."), ("jelly", "STOP SAYING THAT."), ("ribbit", "Hey, ladies?"), ("gelly", "Why are you like this."),
    ("croak", "We are cool."), ("ribbit", "We are very cool."), ("jelly", "You are wearing a bucket."), ("croak", "It is a hat."),
    ("ribbit", "It is MY hat."), ("croak", "It is OUR hat."), ("jelly", "It has a handle."), ("croak", "Vintage."),
    ("narr", "Fourteen minutes later."),
    ("gelly", "Does the car do anything?"), ("croak", "It does the ambience."), ("gelly", "It honks?"), ("ribbit", "It could honk."),
    ("croak", "Ribbit, honk."), ("ribbit", "Honk."), ("jelly", "You said honk. You did not honk."), ("croak", "Honk is a state of mind."),
    ("gelly", "Walk. Just walk."), ("jelly", "Walking."), ("ribbit", "They are walking!"), ("croak", "Follow them. Slowly."),
    ("gelly", "Do not follow us."), ("ribbit", "We are not following."), ("croak", "We are cruising behind."), ("jelly", "Cruising behind IS following."),
    ("croak", "...Ambience."),
]
NAMES = {"croak": ("croak", "croak_cu", "lime"), "ribbit": ("ribbit", "ribbit_cu", "lilac"), "gelly": ("gelly", "gelly_cu", "pink"), "jelly": ("jelly", "jelly_cu", "blue")}
ALL4 = ["croak", "ribbit", "gelly", "jelly"]
WHO = {"croak": "Sir Croak", "ribbit": "Sir Ribbit", "gelly": "Gelly", "jelly": "Jelly", "narr": "Narrator"}
FROGS = ("croak", "ribbit")

## every actor's motion is collected here and written in time order (a hop never overlaps a lurch)
MOVES = {}
def mv(name, t0, t1, x, y, ease="inout", hop=0, hard=False):
    MOVES.setdefault(name, []).append((t0, t1, x, y, ease, hop, hard))
def flush_moves():
    for name, evs in MOVES.items():
        evs.sort(key=lambda e: (e[0], not e[6]))
        last = -1
        for t0, t1, x, y, ease, hop, hard in evs:
            if t0 < last:
                continue
            move(name, t0, t1, x, y, ease=ease, hop=hop)
            last = t1
    MOVES.clear()

CAR0 = [4.0]
FY = 13.4
GX = {"gelly": 20.5, "jelly": 26.4}
def car_to(t0, t1, x, hard=True):
    for nm, off in (("car_back", 0.0), ("car_front", 0.0), ("croak", 6.5), ("ribbit", 2.0)):
        mv(nm, t0, t1, x + off, 13.8 if nm.startswith("car") else FY, ease="inout", hop=0.35, hard=hard)
    CAR0[0] = x

## the car pulls up (and stops a little too hard)
for nm, off in (("car_back", 0.0), ("car_front", 0.0), ("croak", 6.5), ("ribbit", 2.0)):
    move(nm, 0.2, 6.0, -2 + off + 6, 13.8 if nm.startswith("car") else FY, ease="out", hop=0.2) if False else None
for nm, off in (("car_back", 0.0), ("car_front", 0.0), ("croak", 6.5), ("ribbit", 2.0)):
    mv(nm, 0.2, 5.4, 2.0 + off, 13.8 if nm.startswith("car") else FY, ease="out", hard=True)
shake(5.2, 5.9, 0.2)
punch(5.3, 0.12, 0.3)
emote("croak", 5.6, SWEAT, 1.2)
CAR0[0] = 2.0

n_lines = len(LINES)
step = (226.0 - 7.0) / n_lines
lurch_every = 5
hey = 0
def wx(t):                                        ## the wide shot slowly follows the action to the right
    return 16.0 + 6.0 * (t - 2.0) / 224.0
def hey_montage(t):                               ## the running gag: three quick looks, a flash and a shake
    room(t, "lime")
    pose("croak_cu", t, "smug")
    room(t + 0.35, "pink")
    pose("gelly_cu", t + 0.35, "no")
    room(t + 0.7, "blue")
    pose("jelly_cu", t + 0.7, "no")
    wide(t + 1.05, wx(t), 12.8, 1.3)
    flash(t, "#ff3cac", 0.4, 0.2)
    punch(t, 0.1, 0.3)
    emote("gelly", t + 0.4, ANGRY, 1.0)
    emote("jelly", t + 0.8, ANGRY, 1.0)

for i, (who, text) in enumerate(LINES):
    t = 7.0 + i * step
    if who == "narr":
        line(t, text, who="Narrator", seconds=min(step * 0.9, 2.6))
        fade(t - 0.35, t, 0, 1, "black")
        fade(t, t + 0.5, 1, 0, "black")
        x = min(9.0, CAR0[0] + 1.6)
        car_to(t + 0.1, t + 0.9, x)
        for g in ("gelly", "jelly"):
            mv(g, t + 0.1, t + 0.9, GX[g] + 1.6 * ((t - 7) / 50.0 + 1) if False else GX[g], G - GH, ease="inout", hop=0.2)
        wide(t, wx(t), 12.8, 1.0)
        for other in ALL4:
            pose(other, t, "idle")
            pose(other + "_cu", t, "idle")
        continue
    actor_n, cu_n, rm = NAMES[who]
    line(t, text, who=WHO[who], seconds=min(step * 0.92, 3.0))
    talk([actor_n, cu_n], t, t + step * 0.86)
    frog = who in FROGS
    ## everyone else reacts (frogs smirk or sob, the girls refuse), then the speaker hops on the punchline
    for other in ALL4:
        if other != who:
            if frog:
                r = ("no" if other in ("gelly", "jelly") and i % 2 == 0 else "idle") if other not in FROGS else ("smug" if i % 3 else "lean")
            else:
                r = ("cry" if i % 2 else "lean") if other in FROGS else ("no" if i % 3 == 0 else "idle")
            pose(other, t + 0.02, r)
            pose(other + "_cu", t + 0.02, r)
    mv(actor_n, t + 0.05, t + 0.4, GX.get(actor_n, 0) if actor_n in GX else (CAR0[0] + (6.5 if actor_n == "croak" else 2.0)), G - GH if actor_n in GX else FY, hop=0.6)
    loud = text.endswith("!") or text.isupper() or "STOP" in text or "ARE" in text
    if loud:
        shake(t, t + 0.5, 0.22)
        punch(t, 0.12, 0.3)
        flash(t, "#ffe45a", 0.35, 0.2)
        emote(actor_n, t + 0.1, EXCL, 1.0)
    elif text.endswith("?"):
        listener = ALL4[(ALL4.index(who) + 2) % 4]
        emote(listener, t + 0.5, QUEST, 1.2)
    elif text.lower().startswith(("no", "also no", "still no", "keep", "stop")):
        emote(actor_n, t + 0.1, ANGRY, 1.0)
    else:
        punch(t, 0.05, 0.22)
    if text.startswith("Hey, ladies"):
        hey_montage(t)
        continue
    ## the cuts: speaker, listener, a wide with the car in it, a low angle; one every second
    k = i % 5
    if k == 0:
        wide(t, wx(t), 12.8, 1.15)
        room(t + 0.9, rm)
        wide(t + 1.9, CAR0[0] + 7, 14.4, 2.0)
    elif k == 1:
        room(t, rm)
        react = NAMES[ALL4[(ALL4.index(who) + 2) % 4]]
        room(t + 1.0, react[2])
        wide(t + 2.0, wx(t) + 3, 13.0, 1.7)
    elif k == 2:
        wide(t, CAR0[0] + 8, 13.6, 1.7) if frog else wide(t, GX["gelly"] + 3, 12.8, 1.7)
        room(t + 1.1, rm)
        wide(t + 2.1, wx(t), 12.8, 1.2)
    elif k == 3:
        room(t, rm)
        wide(t + 1.0, 12, 15.0, 2.6) if frog else wide(t + 1.0, GX["jelly"], 15.0, 2.6)       ## the feet
        wide(t + 1.9, wx(t), 12.8, 1.2)
    else:
        wide(t, wx(t), 12.2, 1.45)
        room(t + 0.8, rm)
        room(t + 1.8, NAMES[ALL4[(ALL4.index(who) + 1) % 4]][2])
    if i % lurch_every == lurch_every - 1:         ## the car lurches forward, the girls edge away
        x = min(9.0, CAR0[0] + 0.8)
        car_to(t + 2.2, t + 2.8, x)
        mv("gelly", t + 2.2, t + 2.8, GX["gelly"] + 0.3, G - GH, hop=0.3)
        GX["gelly"] += 0.3
        mv("jelly", t + 2.2, t + 2.8, GX["jelly"] + 0.3, G - GH, hop=0.3)
        GX["jelly"] += 0.3
        shake(t + 2.2, t + 2.7, 0.12)
flush_moves()

