BEAT = 60.0 / J["tempo"]
DANCERS_ALL = [(f"d{i}", BEACH_X[i], G - 9.2 + (0.3 if i < 6 else -0.6)) for i in range(8)] + [(f"row{i}", 131 + i * 11, G - 7.0) for i in range(6)] + [("granny", 165, G - 9.2), ("granny2", 143, G - 9.2), ("kid", 172, G - 6), ("kid2", 150, G - 6)]
def hop_all(t0, t1, every=2, amp=0.6):                  ## everyone hops on the beat, a little out of step (and sways)
    for k, (nm, x, y) in enumerate(DANCERS_ALL):
        t = t0 + (k % 4) * BEAT * 0.25
        n = 0
        while t + BEAT * every < t1:
            sway = (0.5 if n % 2 else -0.5) * (1 if k % 2 else -1)
            mv(nm, t, t + BEAT * every * 0.55, x + sway, y, hop=amp + 0.3 * (k % 3))
            t += BEAT * every
            n += 1
hop_all(405.4, 628, 2, 0.6)
for k in range(40):                                      ## the beach ball goes round the crowd
    t0 = 405.5 + k * 3.6
    if t0 > 625:
        break
    mv("ball", t0, t0 + 3.4, [134, 150, 165, 180, 168, 152][k % 6], G - 4.0, ease="inout", hop=8.0)
