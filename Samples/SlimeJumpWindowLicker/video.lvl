def hero_fish(t): fb(t, "fish")
def lit_red(t): fb(t, "red")
def lit_blue(t): fb(t, "blue")
def hero_roll(t): fb(t, "roll")
def xgrin(t):                                             ## an extreme zoom into the grin: one frame per size
    for i in range(4):
        fb(t + i / FPS, f"g{i}")
def xshades(t):
    for i in range(4):
        fb(t + i / FPS, f"s{i}")
def strobe(t, n=6):                                       ## red, blue, red, blue: the lights go round
    for i in range(n):
        (lit_red if i % 2 == 0 else lit_blue)(t + i * 0.25)
def static_cut(t, back):
    room(t, "static")
    back(t + 0.25)
