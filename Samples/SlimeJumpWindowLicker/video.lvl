STAGES = [(320.3, 337), (337, 349), (349, 361), (361, 373), (373, 385), (385, 410)]
for mi, (a, b) in enumerate(STAGES):
    dance("gm", a, b, [f"m{mi}_{k}" for k in range(6)], every=1, hop=0.7)
    dance("gmy", a, b, [f"m{mi}_{(k + 3) % 6}" for k in range(6)], every=1, hop=0.7)
def stage_at(t):
    for mi, (a, b) in enumerate(STAGES):
        if t < b:
            return mi
    return 5
## champagne: pop, spray
show("champ", 336)
for k, c in enumerate(["c0", "c1", "c0", "c2", "c3", "c4", "c5", "c6", "c7", "c7"]):
    pose("champ", 336 + k * 0.25, c)
flash(338.6, "white", 0.7, 0.4)
hide("champ", 342)
def lounge_wide(t): wide(t, 92, 12.8, 1.15)
def lounge_girls(t): wide(t, 92, 12.0, 1.9)
def face_p(t):
    m = min(4, stage_at(t))
    room(t, "teal")
    pose("dface_p", t, f"m{m}")
def face_y(t):
    m = min(4, stage_at(t))
    room(t, "orange")
    pose("dface_y", t, f"m{m}")
def hero_face2(t):
    room(t, "sun")
    pose("hero_cu2", t, "grin" if (t * 7) % 2 < 1 else "crazy")
def champ_cu(t):
    room(t, "red")
    pose("champ_cu", t, "c%d" % min(7, int((t * 3) % 8)))
