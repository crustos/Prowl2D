## SlimeJumpLevelang: SlimeJump, underwater.
##
## Same level as SlimeJump (the bot's route is the one it knows), drawn as levelang art and dressed as a reef:
## sand and rock for the ground, kelp to climb, urchins for the spikes, oysters with pearls for the gems, starfish
## for the checkpoints, a crab and a puffer fish for the enemies, a diving slime, and the anchor as the goal.
## Corals, seaweed, fish, bubbles and shells are scenery: they have no gameplay flag, so none of them reaches Level.cs.
##
## One emoji per cell, two spaces = one cell of air; the top row is the highest y (the game's y is up).
## Each emoji's look is an SVG in svg/. The scripts (*.cs) are SlimeJump's; Level.cs is generated from this file:
##
##     python3 tools/levelang export-cs Samples/SlimeJumpLevelang/level.lvl \
##         -o Samples/SlimeJumpLevelang/Level.cs --layers-from Samples/SlimeJump/Level.cs
##
## and previewed with:   python3 tools/levelang gif Samples/SlimeJumpLevelang/level.lvl --view 32x20 --tile 16 --fps 10 -o Samples/SlimeJumpLevelang/level.gif

meta(width=64, height=20)            ## the level is 64 x 20 cells, origin top-left
background("#7fd4f5", "#06223f")     ## water, light at the top to dark at the bottom (preview only)

## --- terrain: solid -> Walls (merged into rectangles) -------------------------
def 🟨 -> svg("svg/sand.svg"), solid:             ## the floor you stand on

def 🪨 -> svg("svg/rock.svg"), solid:             ## reef rock: the walls and what is under the sand

def 🌿 -> svg("svg/kelp.svg"), climb, bg, sway(0.03):   ## kelp: hold jump to climb. sway() is only the preview

def 🔺 -> svg("svg/urchin.svg"), hazard:          ## sea urchins: Spikes

## --- things to collect --------------------------------------------------------
def 🦪 -> svg("svg/oyster.svg"), item, bob:       ## oysters with a pearl: Gems

def ⭐ -> svg("svg/starfish.svg"), save, at(0.5, 0):   ## starfish: Saves, standing on the sand

## --- enemies: kind 0 walks the sea floor and spits, kind 1 swims (EnemyCfg.cs) -
def 🦀 -> svg("svg/crab.svg"), enemy(0), at(0.5, 0.3):

def 🐡 -> svg("svg/puffer.svg"), enemy(1), bob:

## --- start and finish ---------------------------------------------------------
def 🤿 -> svg("svg/diver.svg"), spawn, at(0.5, 0.575):

def ⚓ -> svg("svg/anchor.svg"), goal, at(0.5, 0):

## --- scenery: no flags, so it is only ever a picture ---------------------------
def 🍥 -> svg("svg/coral.svg"), bg:

def 🌱 -> svg("svg/weed.svg"), bg, sway:

def 🐚 -> svg("svg/shell.svg"), bg:

def 🐟 -> svg("svg/fish.svg"), bg, swim(8):

def 🐠 -> svg("svg/tropical.svg"), bg, swim(8):

def 🫧 -> svg("svg/bubbles.svg"), bg, bob:

## --- scenery tiles for the layers below: they have no gameplay flag, so they are only ever pictures ---
## size() is in cells; a placement can override it (place(🪸, x, y, size=(6, 6))), so one SVG makes corals of every size
def 🐋 -> svg("svg/whale.svg"), bg, swim(14, 1.1), bob:        ## swim(cells, cells per second): a whale is long and slow

def 🏔️ -> svg("svg/ridge_far.svg"), bg, size(36, 12.6):         ## a ridge of coral heads: the far landscape

def ⛰️ -> svg("svg/ridge_near.svg"), bg, size(36, 12.6):

def 🪸 -> svg("svg/coral_branch.svg"), bg, size(2, 2):         ## the big corals, each one an SVG of smooth curves

def 🪻 -> svg("svg/coral_branch2.svg"), bg, size(2, 2):

def 🌷 -> svg("svg/coral_tube.svg"), bg, size(2, 2):

def 🧠 -> svg("svg/coral_brain.svg"), bg, size(2, 2):

def 🍄 -> svg("svg/coral_table.svg"), bg, size(2, 2):

def 🌺 -> svg("svg/coral_fan.svg"), bg, size(2, 2):

def 🌾 -> svg("svg/kelp_long.svg"), bg, sway(0.03), size(1.5, 15):       ## tall kelp: sway(amount) is how far the top leans, per cell of height

def 🎍 -> svg("svg/kelp_dark.svg"), bg, sway(0.02), size(2, 20):         ## dark kelp for the foreground

def 🪼 -> svg("svg/jelly.svg"), bg, bob, swim(5, 0.5), size(1.2, 1.8):

def ☀️ -> svg("svg/rays.svg"), bg, size(60, 20):                ## light from the surface

## --- the level ----------------------------------------------------------------
def reef():
🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨
🪨                                                                                                                            🪨
🪨                                                                                                                            🪨
🪨                                                                                                                      🐡    🪨
🪨                                                                                                                  🦪        🪨
🪨                                                                                                                        ⚓  🪨
🪨                                                                                                                            🪨
🪨                                                                                                              🌿🟨🟨🟨🟨🟨🟨🪨
🪨                                                                                                              🌿🪨🪨🪨🪨🪨🪨🪨
🪨                                                                                                              🌿🪨🪨🪨🪨🪨🪨🪨
🪨                                                                                                              🌿🪨🪨🪨🪨🪨🪨🪨
🪨                                                                                                              🌿🪨🪨🪨🪨🪨🪨🪨
🪨                                                    🦪                                                        🌿🪨🪨🪨🪨🪨🪨🪨
🪨                                                                                        🦪                    🌿🪨🪨🪨🪨🪨🪨🪨
🪨                          🟨🟨🟨🟨🟨🟨🟨                                                                      🌿🪨🪨🪨🪨🪨🪨🪨
🪨    🤿        ⭐          🪨🪨🪨🪨🪨🪨🪨                                        🦀                ⭐          🌿🪨🪨🪨🪨🪨🪨🪨
🪨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🪨🪨🪨🪨🪨🪨🪨🟨🟨🟨              🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🟨🪨🪨🪨🪨🪨🪨🪨
🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🔺🔺🔺🔺🔺🔺🔺🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨
🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🟨🟨🟨🟨🟨🟨🟨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨
🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨🪨

reef()

## --- smooth terrain: the sand and rock keep their square cells for physics, but are drawn through a rounded, gently wavy outline
skin(🟨, 🪨, wobble=0.14, outline="#241c45", outline_width=0.07, seed=4)

## --- life: seeded, so the picture is always the same ----------------------------
seed(11)

def is_solid(cx, cy):
    return any(p.tile.has("solid") for p in level.cell(cx, cy))

def is_free(cx, cy):
    return 0 <= cx < 64 and 0 <= cy < 20 and not level.cell(cx, cy)

BIG = [🪸, 🪻, 🧠, 🍄, 🌺]                 ## the big corals (the tube coral 🌷 is only a small one, on the ground)

## corals on the ground: a layer that moves with the world (parallax=1) is drawn behind the smooth terrain, so the foot of each coral is buried in it
with layer("growth", parallax=1.0):
    for cx in range(64):
        for cy in range(20):                   ## cy is the art row: 0 = top
            if is_free(cx, cy) and is_solid(cx, cy + 1) and rand() < 0.30:
                s = 1.3 + rand() * 1.4
                place(choice(BIG + [🌷]), cx + 0.5 - s / 2 + (rand() - 0.5) * 0.6, cy + 1.25 - s, size=(s, s), flip=chance(0.5))

for cx in range(64):
    for cy in range(20):
        if not is_free(cx, cy):
            continue
        if is_solid(cx, cy + 1):               ## small things grow on the sand and the rock
            r = rand()
            if r < 0.12:
                place(🍥, cx, cy)
            elif r < 0.37:
                for k in range(randint(1, 3)):
                    if is_free(cx, cy - k):
                        place(🌱, cx, cy - k)
            elif r < 0.44:
                place(🐚, cx, cy)
        elif cy < 14 and rand() < 0.008:       ## fish in open water, well above the floor
            place(choice([🐟, 🐠]), cx, cy)
        elif rand() < 0.02:
            place(🫧, cx, cy)

## --- depth: parallax layers. parallax = how much of the camera's movement a layer follows (1 = the world, 0 = fixed to the screen).
## A layer's x = 0 lines up with the world's when the camera is at the left, and it needs about 64 * (1 + parallax) cells of scenery to last the whole level.
## haze=(colour, amount) fogs a layer toward a colour, which is what makes the far things look far.

with layer("rays", parallax=0.05, alpha=0.55):
    place(☀️, -6, -1)
    place(☀️, 50, -1, flip=True)

with layer("whales", parallax=0.10, haze=("#0a3560", 0.32)):
    place(🐋, 6, 1.5, size=(34, 13.6))         ## the blue whale
    place(🐋, 48, 9.5, size=(15, 6), flip=True)   ## and a calf, far behind it

with layer("reef_far", parallax=0.20, haze=("#0d3b6e", 0.58)):
    for i in range(3):                         ## the far landscape: ridges of coral...
        place(⛰️ if i % 2 else 🏔️, -4 + i * 35, 8.6, flip=i % 2 == 1)
    x = -2
    while x < 80:                              ## ...and giant corals along them
        s = 7 + rand() * 6
        place(choice(BIG), x - s / 2, 16.8 - s + rand() * 1.6, size=(s, s), flip=chance(0.5))
        x += 5 + rand() * 4

with layer("reef_mid", parallax=0.40, haze=("#0d3b6e", 0.40)):
    x = 0
    while x < 92:
        s = 4 + rand() * 3
        place(choice(BIG), x - s / 2, 20.4 - s, size=(s, s), flip=chance(0.5))
        x += 3.5 + rand() * 3
    x = 3
    while x < 92:                              ## long kelp in the background
        h = 11 + rand() * 6
        place(🌾, x, 20.6 - h, size=(h / 10, h))
        x += 7 + rand() * 6
    for i in range(6):
        place(🪼, rand() * 90, 2 + rand() * 9, size=(1.2, 1.8))

with layer("kelp_near", parallax=0.65, haze=("#0d3b6e", 0.16)):
    x = 1
    while x < 106:
        h = 14 + rand() * 6
        place(🌾, x, 20.6 - h, size=(h / 10, h), flip=chance(0.5))
        x += 5 + rand() * 4
    for i in range(7):
        place(choice([🐟, 🐠]), rand() * 100, 3 + rand() * 9)

with layer("front", parallax=1.40, over=True, alpha=0.85, haze=("#04182e", 0.45)):
    for x in (2, 47, 93):                      ## dark kelp rushing past in front of everything
        h = 20 + rand() * 4
        place(🎍, x + rand() * 3, 21 - h, size=(h / 14, h))
