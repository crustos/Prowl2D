'''
Sir Croak, the rival: a frog who thinks he is Gelly's suitor.  A wide body, two bulging eyes stamped on 20 and 30,
a throat sac (70) that swells when he croaks, and a mouth (40, 41, 42) that frowns.
'''

def eye(fill={0:white, 10:black}, sizes={10:3}, smooth=1.0):
    0       1


        10


    3       2

def frog(fill={0:forestgreen, 20:white, 70:khaki, 80:darkgreen, 90:darkgreen}, stroke={0:darkgreen, 70:olive, 40:black, 50:black, 60:black}, width={40:0.35, 50:0.4, 60:0.4}, smooth={0:0.75, 70:1.0}, sizes={20:(7, 7), 30:(7, 7), 70:(10, 4), 80:(3, 2), 90:(3, 2)}):
        50                      61
              51          60


            20              30
                    0
          7                   1


            80            90
    6               41              2

          40                42~
                    70
         5                     3
                    4

def pose(look=(0, 0), blink=0, croak=0, angry=1, lift=0):
    s = 1 - blink
    left = eye(shift={10: look}, scale={0: (1, max(0.15, s)), 10: 0 if blink > 0.95 else 1})
    right = eye(shift={10: look}, scale={0: (1, max(0.15, s)), 10: 0 if blink > 0.95 else 1})
    a = angry * 1.2
    return frog({20: left, 30: right}, shift={50: (0, a), 51: (0, -a), 60: (0, -a), 61: (0, a)} if angry else {}, scale={70: 1 + croak}, rotate={})

croak = [pose(croak=c, angry=a) for c, a in [(0, 1), (0.4, 1), (0.9, 1), (0.9, 1), (0.4, 1), (0, 1)]]
blink = [pose(blink=b) for b in [0, 0.6, 1, 0.6, 0]]
glare = [pose(look=(x, 0)) for x in [0, -1, -1, 0, 1, 1]]
rest  = pose()
