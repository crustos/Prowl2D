def 💗 -> kmj(K + "props.kmj", "gem", fps=5, margin=0), size(0.9, 0.9), item:

def 🌸 -> kmj(K + "props.kmj", "bloom", fps=3, margin=0), size(1, 1), save, at(0.5, 0):

def 🐸 -> kmj(K + "frog.kmj", "croak", fps=3, margin=0), size(2, 1.6), enemy(0), at(0.5, 0.3):

def 🦇 -> kmj(K + "bat.kmj", "wings", fps=10, margin=0), size(2.1, 1.6), enemy(1), bob:

def 🐲 -> kmj(K + "dragon.kmj", "glare", fps=3, margin=0), size(3, 3), enemy(1):

def 💒 -> kmj(K + "props.kmj", "wedding", fps=4, margin=0), size(3, 3), goal, at(0.5, 0):

def 🏹 -> fill.dimgray, stroke.white, solid, shooter(-1, 0):
<  <
 <  <

## ---------------------------------------------------------------- people and scenery (no flags: pictures only)
def 👧 -> kmj(K + "gelly.kmj", "wave", fps=4, margin=0), size(2.3, 2), bg:

def 🥺 -> kmj(K + "gelly.kmj", "cry", fps=4, margin=0), size(2.3, 2), bg:

def 👰 -> kmj(K + "gelly.kmj", "bride_love", fps=5, margin=0), size(3, 2.6), bg:

def 🤵 -> kmj(K + "slime.kmj", "love", fps=5, margin=0), size(2.4, 1.7), bg:

def 🐉 -> kmj(K + "dragon.kmj", "glare", fps=3, margin=0), size(4, 4), bg:

def 🌳 -> kmj(K + "props.kmj", "tree_sway", fps=2, margin=0), size(4, 4), bg:

def 🍀 -> kmj(K + "props.kmj", "bush_rest", margin=0), size(2, 1.5), bg:

def ⛅ -> kmj(K + "props.kmj", "cloud_rest", margin=0), size(6, 2), bg:

def 🌄 -> kmj(K + "props.kmj", "hill_rest", margin=0), size(16, 6), bg:

