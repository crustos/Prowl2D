## SlimeJumpRPG: how SlimeJump met his first girlfriend, and married her after many trials and tribulations.
##
## One long level (200 x 20 cells), six chapters left to right.  The physics is SlimeJump's (the same scripts; Level.cs is generated from
## this file), the people are drawn with kaomojilang in kmj/*.kmj (numbers and symbols in text), and the story is told with title() and say():
## they show up in the preview GIF and are printed by the game as the slime gets to them (Story.cs is generated too).
##
##     python3 tools/levelang export-cs    Samples/SlimeJumpRPG/level.lvl -o Samples/SlimeJumpRPG/Level.cs --layers-from Samples/SlimeJump/Level.cs
##     python3 tools/levelang export-story Samples/SlimeJumpRPG/level.lvl -o Samples/SlimeJumpRPG/Story.cs
##     python3 tools/levelang gif          Samples/SlimeJumpRPG/level.lvl --view 40x20 --tile 16 --fps 12 -o Samples/SlimeJumpRPG/level.gif

meta(width=200, height=20)
background("#9fd8ff", "#e8f6ff")

K = "kmj/"

## ---------------------------------------------------------------- terrain (solid -> walls)
def 🟩 -> fill.yellowgreen, stroke.forestgreen, solid:
,  '  ,   .
  .  ,  '  ,

def 🟫 -> fill.peru, stroke.sienna, solid:
.  :   '  .
 '  .  :  '

def 🪨 -> fill.slategray, stroke.dimgray, solid:
 .  :  '  .
:  '  .  :

def 🧱 -> fill.firebrick, stroke.maroon, solid:
= = = =
 = = = =

def 🌉 -> fill.burlywood, stroke.sienna, crumbly:
| | | |
| | | |

## ---------------------------------------------------------------- gameplay things, drawn with kaomojilang
def 🟢 -> kmj(K + "slime.kmj", "idle", fps=6, margin=0), size(1.7, 1.2), spawn, at(0.5, 0.575):

def 🌿 -> kmj(K + "props.kmj", "vine_rest", margin=0), size(1, 1), climb, bg, sway(0.04):

