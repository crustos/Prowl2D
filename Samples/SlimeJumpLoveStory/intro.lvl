## SlimeJumpLoveStory: a music video that opens SlimeJumpRPG.
##
## A level is the stage; scene() is the timeline.  Here the stage is four sets side by side, and the camera does not travel between them, it CUTS:
##
##     x   0 ..  63   the lane (dawn)             x 128 .. 159   close-up room: Slime
##     x  64 .. 127   the club (the dance floor)  x 160 .. 191   close-up room: Gelly
##     x 224 .. 255   the wedding                 x 192 .. 223   close-up room: Sir Croak       x 256 .. 287   close-up room: the bride
##
## A close-up is an actor drawn big (size=...) in its own room, so the face is crisp.  Everything lands on a 120 bpm grid: beat(16) is the drop.
##
##     python3 tools/levelang scene        Samples/SlimeJumpLoveStory/intro.lvl --tile 16 -o Samples/SlimeJumpLoveStory/intro.gif
##     python3 tools/levelang export-scene Samples/SlimeJumpLoveStory/intro.lvl -o Samples/SlimeJumpLoveStory/Cutscene.cs

meta(width=288, height=21)
background("#ffc9a8", "#fff3d9")

K = "kmj/"

## ---------------------------------------------------------------- terrain and backdrops (plain colours)
def 🟩 -> fill.yellowgreen, stroke.forestgreen, solid:
,  '  ,   .
  .  ,  '  ,

def 🟫 -> fill.peru, stroke.sienna, solid:
.  :   '  .
 '  .  :  '

def 🔲 -> svg:
<svg viewBox="0 0 1 1"></svg>

def 🟪 -> fill("#2a1048"), bg:

def 🟦 -> fill("#1e90ff"), bg:

def 🟧 -> fill("#ff9f1c"), bg:

def 🟥 -> fill("#ff3cac"), bg:

def ⬛ -> fill("#1a0a2e"), bg:

def 🟨 -> fill("#ffe45e"), bg:

def 🟡 -> fill("#fff3a0"), bg:

def 🩷 -> fill("#ff6ec7"), bg:

def 💮 -> fill("#ffc2e6"), bg:

def 🟢 -> fill("#7bed9f"), bg:

def ⚪ -> fill("#c6f7d8"), bg:

def 🤍 -> fill("#fff0f5"), bg:

def 🎀 -> fill("#ffb6c1"), bg:

def 🔷 -> fill("#cfe8ff"), bg:

## ---------------------------------------------------------------- the cast: one tile per pose
