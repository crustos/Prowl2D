'''
SlimeJump, drawn with numbers.

A body (the ring 0..7: smooth, flat underneath), a shine (10), two eyes and a mouth that are small drawings stamped
on the points 20, 30 and 40, and two cheeks (50, 60).  A pose is a Python call; an animation is a list of poses.
Gelly, his girlfriend, is gelly.kmj.
'''

## ---------------------------------------------------------------- the eyes
def eye(fill={0:white, 10:black}, sizes={10:2.6}, smooth=1.0):
    0      1

       10

    3      2

def heart_eye(fill=crimson, smooth=0.55):
      5     1
         0
    4         2



         3

def happy_eye(stroke=black, width=0.35, smooth=1.0):
    0      2~

        1

def shade(fill=black, stroke=dimgray, width=0.3, smooth=0.5):
    0       1


    3       2

## ---------------------------------------------------------------- the mouths
def smile(stroke=black, width=0.3, smooth=1.0):
    0         2~

        1

def grin(fill=maroon, smooth=0.8):
    0         1

      3     2

def oh(fill=maroon, smooth=1.0):
       0
    3     1
       2

def flat(stroke=black, width=0.3):
    0     1

def frown(stroke=black, width=0.3, smooth=1.0):
        1

    0         2~

## ---------------------------------------------------------------- the body
def slime(fill={0:limegreen, 10:white, 50:pink, 60:pink}, stroke={0:darkgreen}, smooth=0.75, sizes={10:(3, 2), 20:(5, 6), 30:(5, 6), 40:(7, 3), 50:(4, 3), 60:(4, 3)}):
                  0
         7                 1
          10
            20        30

    6                           2
        50                  60
                  40

        5         4         3

## ---------------------------------------------------------------- poses
## where each part is (col, row) and how tall the body is: squashing scales the body about its centre and keeps its base on the ground
CENTER = [(0, 14, 4.9), (10, 7, 2), (20, 9, 3), (30, 19, 3), (40, 14, 7), (50, 4, 6), (60, 24, 6)]
BASE = (14, 9)

def pose(sx=1, sy=1, lift=0, look=(0, 0), blink=0, mouth=smile(), eyes=0, tilt=0, color=limegreen, wink=False, shades=False):
    s = 1 - blink
    if eyes == 1:
        left = heart_eye()
        right = heart_eye()
    elif eyes == 2:
        left = happy_eye()
        right = happy_eye()
    else:
        left = eye(shift={10: look}, scale={0: (1, max(0.1, s)), 10: 0 if blink > 0.95 else 1})
        right = eye(shift={10: look}, scale={0: (1, max(0.1, s)), 10: 0 if blink > 0.95 else 1})
    if wink:
        left = happy_eye()
    if shades:
        left = shade()
        right = shade()
    move = {i: ((c - BASE[0]) * (sx - 1), (r - BASE[1]) * (sy - 1) - lift) for i, c, r in CENTER}
    return slime({0: color, 20: left, 30: right, 40: mouth}, shift=move, scale={0: (sx, sy)}, rotate={0: tilt})

## ---------------------------------------------------------------- animations
idle  = [pose(), pose(sy=1.04, sx=0.98), pose(sy=1.06, sx=0.97), pose(sy=1.03, sx=0.98), pose(), pose(blink=0.6), pose(blink=1), pose(blink=0.5)]
hop   = [pose(sx=1.2, sy=0.78), pose(sx=0.88, sy=1.22, lift=2), pose(sx=0.9, sy=1.15, lift=4, mouth=grin()), pose(sx=0.95, sy=1.05, lift=2), pose(sx=1.22, sy=0.76, mouth=oh())]
look  = [pose(look=(x, y)) for x, y in [(0, 0), (-1.2, 0), (-1.2, -0.4), (0, 0), (1.2, 0), (1.2, 0.4)]]
love  = [pose(eyes=1, mouth=grin(), sy=1.0 + 0.05 * k, sx=1.0 - 0.03 * k, lift=k) for k in [0, 1, 2, 1]]
happy = [pose(eyes=2, mouth=grin(), lift=k, sy=1.0 + 0.04 * k) for k in [0, 1, 2, 1]]
sad   = [pose(look=(0, 1), mouth=frown(), sy=0.92 + 0.02 * k, sx=1.04, blink=0.3 * (k % 2)) for k in [0, 1, 2, 1]]
scared= [pose(mouth=oh(), sy=1.1, sx=0.92, tilt=t) for t in [-4, 4, -4, 4]]
rest  = pose()
shy   = [pose(look=(-1.2, 0.8), mouth=smile(), sy=1.0 + 0.02 * k, lift=0.0 + 0.5 * (k % 2)) for k in [0, 1, 2, 1]]

## ---------------------------------------------------------------- the music video poses: reactions, and moves that land on the beat
nervous = [pose(look=(-1.2, 0.6), mouth=flat(), sx=0.94, sy=1.06, tilt=t, blink=b) for t, b in [(-1, 0), (1, 0), (-1, 0.5), (1, 0)]]
shock   = [pose(mouth=oh(), sx=0.85, sy=1.25, lift=k, look=(0, -0.3)) for k in [0, 2, 0, 2]]
wink    = [pose(wink=True, mouth=grin(), lift=k, sy=1.0 + 0.03 * k) for k in [0, 1, 0, 1]]
cool    = [pose(shades=True, mouth=grin(), lift=k, sy=1.0 + 0.03 * k) for k in [0, 1, 0, 1]]
dance_a = [pose(eyes=2, mouth=grin(), tilt=-7, sx=1.12, sy=0.88), pose(eyes=2, mouth=grin(), tilt=-3, sx=1.06, sy=0.95, lift=1)]
dance_b = [pose(eyes=2, mouth=grin(), tilt=7, sx=0.9, sy=1.18, lift=3), pose(eyes=2, mouth=grin(), tilt=3, sx=0.94, sy=1.1, lift=2)]
groove_a = [pose(shades=True, mouth=grin(), tilt=-7, sx=1.12, sy=0.88), pose(shades=True, mouth=grin(), tilt=-3, sx=1.06, sy=0.95, lift=1)]
groove_b = [pose(shades=True, mouth=grin(), tilt=7, sx=0.9, sy=1.18, lift=3), pose(shades=True, mouth=grin(), tilt=3, sx=0.94, sy=1.1, lift=2)]
