## AphexNIN: the NIN2 sewer stage (the band, the speakers, the synths, the rain and the mud) meets the video of Window Licker (the hero in his white suit, the grin that
## everyone gets, the rooms of faces). The audience, and the dancers on every speaker, are girls in bikinis and bows, covered in mud, wearing the grin.
## Run  python3 make_assets.py  first (it draws the frames in svg/, reusing Samples/NIN2 and Samples/SlimeJumpWindowLicker).
##   python3 ../../tools/levelang export-html stage.lvl -o aphexnin_chaos.html
##   python3 ../../tools/levelang scene stage.lvl --sheet /tmp/stage.png --at 0,6,12,18
meta(width=130, height=122)
background("#222a30", "#4c5448")

W, H = 130, 58
DECK = 48                       ## the top of the stage floor (concrete)
BANK = 53                       ## the top of the ditch's mud
LIP = 56                        ## x where the stage ends and the ditch begins
SVG = "svg/"

## ---------------------------------------------------------------- tiles
## tiles made in code (no emoji needed, as in the Window Licker video)
def mk(name, *attrs):
    return __tile__(name, "", list(attrs))

def sq(name, pattern, w, h, fps=6):
    return mk(name, svgs("svg/" + pattern, fps=fps), size(w, h))

def sv(name, file, w, h, *more):
    return mk(name, svg("svg/" + file), size(w, h), *more)

def 🧱 -> fill("#5d6164"), solid:

def 🟫 -> fill("#33241a"), solid:

def 🔲 -> svg:
<svg viewBox="0 0 1 1"></svg>

def 🪟 -> svg(SVG + "wall.svg"), bg, size(52, 46):

def 🚰 -> svg(SVG + "pipes.svg"), bg, size(35, 33):

## the muddy water (seamless: 8 cells wide), the stream over the lip, rain, worms
def 🌊 -> svgs(SVG + "mud_*.svg", fps=8), size(8, 2):

def 💧 -> svgs(SVG + "fall_*.svg", fps=12), size(2, 8):

def 🌧 -> svgs(SVG + "rain_near_*.svg", fps=12), size(120, 66):

def 🌦 -> svgs(SVG + "rain_far_*.svg", fps=12), size(120, 66):

def 🪱 -> svgs(SVG + "worm_0_*.svg", fps=8), size(1.8, 0.6):

def 🐛 -> svgs(SVG + "worm_1_*.svg", fps=8), size(1.8, 0.6):

def 🦠 -> svgs(SVG + "worm_2_*.svg", fps=8), size(1.8, 0.6):

## the audience (6 people, 12 frames of fast head-banging each; every other one throws mud) and the band (16 frames, hunched, banging 4 times a second)
def 🧟 -> svgs(SVG + "crowd_0_*.svg", fps=12), size(2.4, 3.4):

def 🧛 -> svgs(SVG + "crowd_1_*.svg", fps=12), size(2.4, 3.4):

def 🧙 -> svgs(SVG + "crowd_2_*.svg", fps=12), size(2.4, 3.4):

def 🧝 -> svgs(SVG + "crowd_3_*.svg", fps=12), size(2.4, 3.4):

def 🧞 -> svgs(SVG + "crowd_4_*.svg", fps=12), size(2.4, 3.4):

def 🧜 -> svgs(SVG + "crowd_5_*.svg", fps=12), size(2.4, 3.4):

def 🎸 -> svgs(SVG + "band_guitar_*.svg", fps=16), size(5.5, 7.8):

def 🪕 -> svgs(SVG + "band_bass_*.svg", fps=16), size(5.5, 7.8):

def 🥁 -> svgs(SVG + "band_drums_*.svg", fps=16), size(6.0, 8.5):

def 🎹 -> svgs(SVG + "band_keys_*.svg", fps=16), size(5.5, 7.8):

def 🎤 -> kmj("kmj/singer.kmj", "singer", fps=8, seconds=60, speed=2, margin=0), size(14, 11):

## speakers (pulsing cones), the feedback rings, synths / drum machines / racks (blinking lights, working hands), fog
def 🔊 -> svgs(SVG + "spk_wall_*.svg", fps=12), size(10, 15):

def 📦 -> svgs(SVG + "spk_cab_*.svg", fps=12), size(5, 5):

def 🔉 -> svgs(SVG + "spk_mon_*.svg", fps=12), size(4.5, 2.5):

def 📢 -> svgs(SVG + "feedback_*.svg", fps=12), size(9, 9):

def 🎛 -> svgs(SVG + "rig_synth1_*.svg", fps=12), size(7.5, 4.875):

def 🎚 -> svgs(SVG + "rig_synth2_*.svg", fps=12), size(7.5, 4.875):

def 📟 -> svgs(SVG + "rig_drum1_*.svg", fps=12), size(7.5, 4.875):

def 🕹 -> svgs(SVG + "rig_drum2_*.svg", fps=12), size(7.5, 4.875):

def 🗄 -> svgs(SVG + "rig_rack1_*.svg", fps=12), size(7.5, 4.875):

def 📠 -> svgs(SVG + "rig_rack2_*.svg", fps=12), size(7.5, 4.875):

def 🌫 -> svgs(SVG + "fog_*.svg", fps=6), size(60, 14):

## the back rows are drawn simpler (a third of the shapes) and with 4 frames: there are many of them
def 🐒 -> svgs(SVG + "crowdfar_0_*.svg", fps=6), size(2.4, 3.4):

def 🦍 -> svgs(SVG + "crowdfar_1_*.svg", fps=6), size(2.4, 3.4):

def 🦧 -> svgs(SVG + "crowdfar_2_*.svg", fps=6), size(2.4, 3.4):

def 🐵 -> svgs(SVG + "crowdfar_3_*.svg", fps=6), size(2.4, 3.4):

def 🙈 -> svgs(SVG + "crowdfar_4_*.svg", fps=6), size(2.4, 3.4):

def 🙉 -> svgs(SVG + "crowdfar_5_*.svg", fps=6), size(2.4, 3.4):

## the mud girls (artlib/👯.py): 12 frames of fast dancing for the audience (every other one throws mud), 6 simpler frames for the back rows, 16 frames for the speakers
GIRL = [sq(f"girl{v}", f"girl_{v}_*.svg", 2.7, 3.55, 12) for v in range(6)]
GIRL_FAR = [sq(f"girlfar{v}", f"girlfar_{v}_*.svg", 2.7, 3.55, 6) for v in range(6)]
STAGE_GIRL = [sq(f"stagegirl{v}", f"stagegirl_{v}_*.svg", 4.6, 6.0, 16) for v in range(4)]
HERO = sq("hero", "hero_dance_*.svg", 8, 9.2, 8)                       ## the slime in the white suit, muddied
HERO_STRUT = sq("herostrut", "hero_strut_*.svg", 8, 9.2, 6)

CROWD = [🧟, 🧛, 🧙, 🧝, 🧞, 🧜]
CROWD_FAR = [🐒, 🦍, 🦧, 🐵, 🙈, 🙉]
WORMS = [🪱, 🐛, 🦠]

## ---------------------------------------------------------------- the ground
place(🔲, 0, -76)
place(🔲, W - 1, H - 1)
for cx in range(0, LIP):                           ## the stage floor and what is under it
    for cy in range(DECK, H):
        place(🧱, cx, cy)
for cx in range(LIP, W):                           ## the ditch
    for cy in range(BANK, H):
        place(🟫, cx, cy)
for cy in range(DECK, BANK):                       ## the lip of the stage is the ditch's wall
    place(🧱, LIP, cy)
skin(🧱, wobble=0.03, corner=0.12, outline="#26282a", outline_width=0.1, seed=2)
skin(🟫, wobble=0.18, outline="#1d130c", outline_width=0.12, seed=5)

## ---------------------------------------------------------------- scenery behind (layers: far, the wall and the pipes, the audience)
def ⬛ -> fill("#12161a"), bg:

seed(4)
with layer("skyline", parallax=0.2, parallax_y=1.0, haze=("#46504a", 0.3)):         ## a far industrial skyline in the rain: blocks and chimneys
    cx = -10
    while cx < 150:
        w = 3 + rand() * 6
        place(⬛, cx, 30 - rand() * 12, size=(w, 40))
        if chance(0.3):
            place(⬛, cx + w * 0.4, 14 + rand() * 6, size=(1.1, 30))
        cx += w + rand() * 2

with layer("wall", parallax=1.0):
    place(🪟, 6, 2)                                  ## the concrete headwall with the arched mouth (the mouth spans x 13..51, y 6..48)
    place(🚰, 8, 3)                                  ## the toilet on its pipes; its spout (x 36, y 36) is where the singer's mud will come from

## the ground the audience stands on rises away from the ditch: three steps of mud, the farther the darker
def 🟤 -> fill("#4a4034"), bg:

def 🟠 -> fill("#37302a"), bg:

with layer("hill", parallax=1.0):
    place(🟠, LIP + 1, BANK - 3.4, size=(W - LIP - 1, 4))
    place(🟤, LIP + 1, BANK - 1.7, size=(W - LIP - 1, 2.5))

seed(8)
FOOT = 0.98                                         ## the feet are at 98% of a figure's height
def standing(tile, x, feet, h, flip=True):
    place(tile, x, feet - FOOT * h, size=(h * 0.704, h), flip=flip)

def girl_at(tile, x, feet, h, flip=True):             ## the girls are a little wider than the mud people (70 x 92)
    place(tile, x, feet - 0.957 * h, size=(h * 0.76, h), flip=flip)

with layer("crowd_far", parallax=1.0, haze=("#37302a", 0.3)):          ## the back rows are smaller, higher, a little lost in the rain
    cx = LIP + 3
    while cx < W - 1:
        if chance(0.9):
            if chance(0.15):
                standing(choice(CROWD_FAR), cx + rand() * 0.6, BANK - 2.6, 1.7 + rand() * 0.3)
            else:
                girl_at(choice(GIRL_FAR), cx + rand() * 0.6, BANK - 2.6, 1.9 + rand() * 0.3)
        cx += 1.1
with layer("crowd_mid", parallax=1.0, haze=("#37302a", 0.12)):
    cx = LIP + 2
    while cx < W - 1:
        if chance(0.85):
            if chance(0.12):
                standing(choice(CROWD_FAR), cx + rand() * 0.7, BANK - 1.0, 2.3 + rand() * 0.4)
            else:
                girl_at(choice(GIRL_FAR), cx + rand() * 0.7, BANK - 1.0, 2.6 + rand() * 0.4)
        cx += 1.2
with layer("crowd_near", parallax=1.0):
    cx = LIP + 1.5
    while cx < W - 1:
        if chance(0.9):
            if chance(0.15):
                standing(choice(CROWD), cx + rand() * 1.1, BANK + 0.5, 3.1 + rand() * 0.5, flip=chance(0.9))
            else:
                girl_at(choice(GIRL), cx + rand() * 1.1, BANK + 0.5, 3.5 + rand() * 0.6, flip=chance(0.9))
        cx += 1.8

## ---------------------------------------------------------------- in front of the stage's floor (what moves)
for cx in range(0, LIP, 8):                        ## the mud that has run across the floor
    place(🌊, cx, DECK - 1.15)
for cy in range(DECK - 1, BANK - 1, 8):             ## and falls over the lip in a stream
    place(💧, LIP - 1, cy)
for cx in range(LIP, W, 8):                        ## the ditch is a river of mud
    place(🌊, cx, BANK - 1.2)
seed(21)
for i in range(14):                                 ## worms on the floor and on the bank
    place(choice(WORMS), 4 + rand() * (LIP - 10), DECK - 0.8 + rand() * 0.3, flip=chance(0.5))
for i in range(10):
    place(choice(WORMS), LIP + 3 + rand() * (W - LIP - 8), BANK - 0.9, flip=chance(0.5))

## the speakers behind the band: the biggest stack of all at the left edge, where the guitarist leans into it; cabinets behind the drums; a wall behind each rig
with layer("speakers", parallax=1.0):
    place(🔊, 2, DECK - 15)                          ## THE speaker: its big woofer is at (7, 46), the guitarist's chest
    place(📦, 13, DECK - 5)
    place(📦, 13, DECK - 10)
    place(📦, 18, DECK - 5)
    place(🔊, 36.5, DECK - 9, size=(6, 9))
    place(🔊, 48.5, DECK - 9, size=(6, 9))
    place(📦, 43, DECK - 5)
    place(📦, 43, DECK - 10)
    place(HERO, 3.6, DECK - 15 - 9.2 * 0.957)         ## the hero, in his white suit with mud up to the knees, dances on top of the biggest speaker
    for gx, gy, gv in ((14.2, DECK - 10, 0), (19.2, DECK - 5, 1), (38.0, DECK - 9, 2), (50.4, DECK - 9, 3), (44.2, DECK - 10, 0), (9.0, DECK - 15, 1)):
        place(STAGE_GIRL[gv], gx, gy - 0.957 * 6.0, flip=chance(0.5))     ## and the girls dance on the other speakers

RIGX = [37, 43.5, 50]                                ## the hardware: a hunched player behind each rig, hands on the sliders and knobs
with layer("band", parallax=1.0, over=True):        ## the band on the stage, over the floor (the singer is in the middle, under the spout)
    place(🥁, 18.5, DECK - 8.0)
    place(🪕, 13.5, DECK - 7.4)
    place(🎸, 4.3, DECK - 7.4, flip=True)           ## the guitarist: facing the big speaker
    place(🎤, 27, DECK - 10.2)
    place(🎛, RIGX[0], DECK - 4.9)
    place(📟, RIGX[1], DECK - 4.9)
    place(🗄, RIGX[2], DECK - 4.9)
    place(🔉, 24.5, DECK - 2.3)
    place(🔉, 30, DECK - 1.9, flip=True)
    place(🔉, 21.5, DECK - 2.3, flip=True)
    place(🎹, 32.5, DECK - 7.4)                     ## the keyboardist at his board (smashed now and then)

with layer("fog", parallax=1.0, over=True, alpha=0.55):    ## a low fog drifting across the stage and the pit
    place(🌫, 0, DECK - 8)
    place(🌫, 60, BANK - 10)
    place(🌫, 20, BANK - 8)

with layer("rain_far", parallax=0.0, over=True):    ## the rain stays on the screen: far drops, small and pale; then near ones, big and quick
    place(🌦, 0, 0, size=(120, 66))
with layer("rain_near", parallax=0.0, over=True):
    place(🌧, 0, 0, size=(120, 66))

## ---------------------------------------------------------------- the rooms (above the stage: the camera cuts to them like the close-ups of Window Licker)
RW, RH = 40, 22.5
ROOMX = [0, 45, 90]
ROOMY = [-36, -64]
place(sv("room_a", "room_pink.svg", RW, RH, bg), ROOMX[0], ROOMY[0])
place(sq("mudface_a", "mudface_0_*.svg", 30, 21.8, 8), ROOMX[0] + 5, ROOMY[0] + 0.35)
place(sv("room_b", "room_hero.svg", RW, RH, bg), ROOMX[1], ROOMY[0])
place(sq("herofaces", "hero_face_0[0-3].svg", 30, 21.8, 7), ROOMX[1] + 5, ROOMY[0] + 0.35)
place(sq("room_c", "spinring_*.svg", RW, RH, 9), ROOMX[2], ROOMY[0])
place(sv("room_d", "room_blue.svg", RW, RH, bg), ROOMX[0], ROOMY[1])
place(sq("mudface_b", "mudface_2_*.svg", 30, 21.8, 8), ROOMX[0] + 5, ROOMY[1] + 0.35)
place(sq("room_e", "tvwall_*.svg", RW, RH, 3), ROOMX[1], ROOMY[1])
place(sv("room_f", "room_orange.svg", RW, RH, bg), ROOMX[2], ROOMY[1])
place(sq("herolick", "hero_lick_*.svg", 30, 21.8, 3), ROOMX[2] + 5, ROOMY[1] + 0.35)

## ---------------------------------------------------------------- the scene (a wide shot, then a few closer)
scene("stage", seconds=24, fps=12, view=(40, 22), bpm=140)
rain(1.0)                              ## the HTML page draws the rain itself (the layers named rain_* are for the GIF preview)
cam(0, 50, 40, 0.5)                    ## wide: the stage, the mouth, the pipes, and the ditch full of people
cam(6, 52, 40, 0.5)
cam(10, 38, 40, 1.0)                   ## the band
cam(13, 8, 44, 2.2)                    ## the guitarist and the big speaker
cam(15, 36, 29, 1.0)                   ## up the pipes to the toilet
cam(19, 70, 45, 1.25)                  ## over the audience
cam(24, 62, 42, 0.55)
fx(0, 24, "vignette", 1.0)
fx(0, 24, "grain", 0.4)

## the random director (open the exported page with  #chaos=7  ; see tools/levelang/README.md): where to cut, who gets smashed, where the pit is
chaos(shots=[(50, 40, 0.5), (38, 40, 1.0), (36, 29, 1.0), (70, 46, 1.2), (62, 43, 0.6), (20, 41, 1.3), (36, 22, 0.8)],
      singer=(34, 43), band={"guitar": 🎸, "bass": 🪕, "keys": 🎹, "drums": 🥁}, pit=(LIP + 3, W - 4, BANK + 0.5), crowd=GIRL + GIRL + [🧟, 🧛],
      lights=[(16, 6), (36, 4), (52, 6)], floor=DECK, grain=0.35,
      rooms=[(ROOMX[i % 3], ROOMY[i // 3], RW, RH) for i in range(6)],  ## and cuts to the rooms of big faces now and then
      smash_at={"guitar": (8.6, 42.8)},                              ## the guitarist smashes his guitar on the big speaker's face
      feedback=(📢, 7.0, 46.0, 9),                                    ## and the feedback flares around it
      rigs=[(RIGX[0], DECK - 4.9, 7.5, 4.9), (RIGX[1], DECK - 4.9, 7.5, 4.9), (RIGX[2], DECK - 4.9, 7.5, 4.9)],     ## close-ups of the hands on the controls
      throw=1.8)                                                     ## volleys of mud from the crowd at the crowd, the band and the stage
