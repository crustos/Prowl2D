## a plain Python section: bare tiles are emitted at the cursor, one row each
def nook(x, y):
    x += 1
    🐚


## ═══ the level ═══════════════════════════════════════════════════════════════
def ground(cx):                       ## y of the sand surface in column cx
    if cx < 38:
        return 21
    return 21 - int(2.4 * max(0.0, math.sin((cx - 38) / 4.0)))

## water surface
x = 0; y = 0
🟦*W

## drifting life: every row, each cell may hold a fish, a tropical fish or a bubble
x = 0; y = 2
for _ in range(17):
    (🐟*0.03 or 🐠*0.03 or 🫧*0.05)*W

## seabed: sand on top of reef rock
for cx in range(W):
    x = cx; y = ground(cx)
    🟨
    for _ in range(y, H):         ## (y already moved down one row after the sand tile)
        🟪

## random corals and seaweed along the seabed (skipping the hand-made sections)
for cx in range(W):
    if 2 <= cx <= 15 or 26 <= cx <= 33:
        continue
    r = rand()
    if r < 0.30:
        h = randint(2, 4)
        x = cx; y = ground(cx) - h
        for _ in range(h):
            🌿
    elif r < 0.50:
        x = cx; y = ground(cx) - 1
        🪸

kelp_forest(x=2, y=15)
reef(nook, x=26, y=8)

## hazards the bot has to steer around
for hx, hy in [(14, 10), (22, 15), (40, 6), (47, 13), (56, 9)]:
    x = hx; y = hy
    🪼
x = 36; y = 18
🐡
x = 52; y = 17
🐡
x = 20; y = 20
🐙

## shells to collect
for sx, sy in [(20, 5), (10, 20), (31, 19), (28, 20), (45, 18), (58, 14)]:
    x = sx; y = sy
    🐚

x = 2; y = 2
🤿
x = 61; y = ground(61) - 1
⚓
