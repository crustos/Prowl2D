## ─────────────────────────────────────────────────────────────────────────────
##  UNDERWATER  —  first levelang test level
##  corals 🪸  seaweed 🌿  fish 🐟🐠   hazards 🪼🐡   a diver 🤿 swims to the anchor ⚓ collecting shells 🐚
##
##  run:   python -m levelang gif examples/underwater.lvl --seed 7
## ─────────────────────────────────────────────────────────────────────────────
import math

W, H = 64, 28
seed(7)
background("#7fd4f5", "#06223f")      ## water gradient, top -> bottom


## ═══ tiles ═══════════════════════════════════════════════════════════════════
## ASCII pattern tiles: the pattern repeats across every tile of this kind,
## `fill` is the background colour and `stroke` the colour of the characters.
def 🟦 -> fill.deepskyblue, stroke.white, bg:
~  ~.~ ~~ ~
 ~ ~ ~ ~~~.
~~. ~.~ ~ ~

def 🟨 -> fill.khaki, stroke.goldenrod, solid:
.  ,   .  '  ,
  '  .   ,  .
,  .  '   .  '

def 🟪 -> fill.rebeccapurple, stroke.mediumpurple, solid:
 .   :  '   .
:   '  .  :
  .  :   '  '

## SVG tiles: the markup sits right under the header.  Flags: solid hazard item spawn goal bg fg
## Motion: sway  bob  swim(n)
def 🤿 -> svg, spawn:
