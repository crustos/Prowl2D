## ─────────────────────────────────────────────────────────────────────────────
##  KAOMOJI  —  characters drawn with kaomojilang (tools/kaomojilang), placed in a level
##  `kmj(file, shape-or-list, fps=, **args)` makes a tile from a .kmj file: a shape def called with the
##  arguments, or a list of shapes (an animation, drawn on a shared canvas).
##
##  run:   python -m levelang gif examples/kaomoji.lvl
## ─────────────────────────────────────────────────────────────────────────────
W, H = 24, 10
background("#cfe8ff", "#7aa8d8")

KMJ = "../../kaomojilang/examples/"

def 🧱 -> fill.sienna, stroke.saddlebrown, solid:
= = = =
 = = = =

def 🗣 -> kmj(KMJ + "face_anim.kmj", "talk", fps=5), size(4, 4), bg:

def 😉 -> kmj(KMJ + "face_anim.kmj", "blink", fps=3), size(4, 4), bg:

def 😮 -> kmj(KMJ + "face_anim.kmj", "emotes", fps=2), size(4, 4), bg:

def 🐻 -> kmj(KMJ + "bear.kmj", "bear"), size(4, 4), bg:

def 🧸 -> kmj(KMJ + "bear.kmj", "cuddly", fps=2), size(4, 4), bg:

place(🗣, 1, 2)
place(😉, 6, 2)
place(😮, 11, 2)
place(🐻, 16, 2)
place(🧸, 20, 2)
y = 8
🧱*W
🧱*W
